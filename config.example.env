# Copy this file to config.env and set the paths on YOUR machine.
# config.env is gitignored. Do not put an ISO inside this repo.

# Your dump of Revelations: Persona (PSP). Keep this outside the repo
P1_ISO=/absolute/path/to/P1.iso

# Where patched test ISOs are written. Keep this outside the repo.
P1_TEST_ISO=/absolute/path/to/P1_test.iso

# Inner PersonaFlowReader folder (the one with extracted/, output/, *.jar).
# You need to build PersonaFlowReader to get the jar that can be executed to decode and encode the files of the game
PFR_ROOT=/absolute/path/to/PersonaFlowReader/PersonaFlowReader
